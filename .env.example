GEMINI_API_KEY=your-api-key-here
PORT=1999
MAX_IMAGE_MB=5

# --- Access control (optional) ---
# EVENT_CODE: require attendees to enter this code before using the app.
# Leave empty to disable the gate (anyone with the link can use it).
EVENT_CODE=
# DAILY_LIMIT: max number of image generations per day (0 = unlimited).
# Acts as a safety cap on Gemini token usage.
DAILY_LIMIT=0

# --- Image storage (optional) ---
# If the AWS_* vars below are set, generated images are uploaded to an
# S3-compatible bucket and a public URL is returned. If left empty, images are
# saved locally to ./storage and served from /storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
