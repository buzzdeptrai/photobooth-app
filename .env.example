GEMINI_API_KEY=your-api-key-here
PORT=1999
MAX_IMAGE_MB=5

# --- Access control (optional) ---
# EVENT_CODE: require attendees to enter this code before using the app.
# Leave empty to disable the gate (anyone with the link can use it).
EVENT_CODE=
# DAILY_LIMIT: max number of image generations per day (0 = unlimited).
# Acts as a safety cap on Gemini token usage.
DAILY_LIMIT=0
# PER_USER_LIMIT: max successful generations per person (by INITIAL) for the
# whole event (0 = unlimited). Soft cap: the INITIAL is user-entered.
PER_USER_LIMIT=20

# --- Image storage (optional) ---
# If the AWS_* vars below are set, generated images are uploaded to an
# S3-compatible bucket and a public URL is returned. If left empty, images are
# saved locally to ./storage and served from /storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

# --- Concurrency limiter (protect VPS RAM) ---
# MAX_CONCURRENT_GENERATE: how many Gemini calls run at once (default 5).
# MAX_GENERATE_QUEUE: how many requests may wait before returning 503 (default 25).
MAX_CONCURRENT_GENERATE=5
MAX_GENERATE_QUEUE=25

# --- Discord alerts (optional) ---
# When set, the server posts a throttled message when requests start queuing
# and when it is overloaded (503). Leave empty to disable.
DISCORD_WEBHOOK_URL=
# SERVER_NAME: shown in every alert so you know which server is affected
# (defaults to the machine hostname).
SERVER_NAME=
# DISCORD_COOLDOWN_MS: min gap between repeated alerts of the same type (anti-spam).
DISCORD_COOLDOWN_MS=60000
# GEN_ALERT_THRESHOLD: send a milestone alert when this many images have been
# generated successfully (counts reset on server restart).
GEN_ALERT_THRESHOLD=400
# GEN_ALERT_STEP: after the threshold, alert again every N generated images.
GEN_ALERT_STEP=50
